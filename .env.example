# Public Supabase configuration used by the Expo client.
# Copy this file to .env locally and fill in values from the Supabase Connect dialog.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional: set after running `eas init` to enable Expo push-token registration.
# EXPO_PUBLIC_EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID
