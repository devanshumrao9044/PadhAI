{
  "expo": {
    "name": "PadhAI",
    "slug": "PadhAI",
    "version": "1.0.29",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "padhai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.padhai.app"
    },
    "android": {
      "package": "com.padhai.app",
      "versionCode": 29,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-logo-dark.png",
            "backgroundColor": "#0D1B22"
          }
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc9a9d86-2535-4c4a-ae52-413d43ab17ce"
      }
    },
    "owner": "devansh9044"
  }
}
